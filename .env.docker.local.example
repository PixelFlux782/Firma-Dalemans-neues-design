NEXT_PUBLIC_SITE_URL=http://localhost:3000
COMMERCE_PROVIDER=local

# Absichtlich unkonfiguriert: Lokale Machbarkeitstests senden keine E-Mails.
CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=anfrage@dalemans.de
CONTACT_MAIL_TEST_MODE=true
CONTACT_TEST_TO_EMAIL=
INQUIRY_TO_EMAIL=anfrage@dalemans.de
INQUIRY_MAIL_TEST_MODE=true
