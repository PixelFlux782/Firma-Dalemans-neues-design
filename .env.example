NEXT_PUBLIC_SITE_URL=https://stapelstuhl-klapptisch.de

# Active commerce source. Local works without external services or credentials.
COMMERCE_PROVIDER=local

# Shopify Storefront API (server-side only, reserved for the future provider)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=

CONTACT_SMTP_HOST=
CONTACT_SMTP_PORT=587
CONTACT_SMTP_SECURE=false
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=info@dalemans.de

# Isoliertes Staging: erzwingt für das Kontaktformular diesen Testempfänger.
# In Staging auf true setzen; niemals eine reale Kundenadresse als Testziel nutzen.
CONTACT_MAIL_TEST_MODE=false
CONTACT_TEST_TO_EMAIL=

# Angebotsanfragen verwenden dieselbe SMTP-Verbindung. Ohne Override geht die
# interne Anfrage fest an info@dalemans.de.
INQUIRY_TO_EMAIL=info@dalemans.de

# Im Testbetrieb werden interne Mail und Kundenbestätigung ausschließlich an
# diese Testadresse umgeleitet. Niemals mit einer realen Kundenadresse testen.
INQUIRY_MAIL_TEST_MODE=false
INQUIRY_TEST_TO_EMAIL=

# Geheimes, stabiles Salt aus dem Plattform-Secret-Store; nicht committen.
FORM_RATE_LIMIT_HASH_SALT=

# Gemeinsamer Formularschutz via Upstash Redis (serverseitig, erforderlich).
FORM_PROTECTION_REST_URL=
FORM_PROTECTION_REST_TOKEN=

# Alternativ werden die offiziellen Upstash-Namen unterstützt. Je Umgebung
# entweder das FORM_PROTECTION_*-Paar oder dieses UPSTASH_*-Paar setzen.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
