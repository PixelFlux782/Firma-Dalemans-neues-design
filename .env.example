NEXT_PUBLIC_SITE_URL=https://stapelstuhl-klapptisch.de

# Active commerce source. Local works without external services or credentials.
COMMERCE_PROVIDER=local

# Shopify Storefront API (server-side only, reserved for the future provider)
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
SHOPIFY_STOREFRONT_API_VERSION=

CONTACT_SMTP_HOST=smtp.ionos.de
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=
CONTACT_SMTP_PASSWORD=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=anfrage@dalemans.de

# Isoliertes Staging: erzwingt für das Kontaktformular diesen Testempfänger.
# In Staging auf true setzen; niemals eine reale Kundenadresse als Testziel nutzen.
CONTACT_MAIL_TEST_MODE=false
CONTACT_TEST_TO_EMAIL=

# Angebotsanfragen verwenden dieselbe SMTP-Verbindung. Ohne Override geht die
# interne Anfrage fest an anfrage@dalemans.de.
INQUIRY_TO_EMAIL=anfrage@dalemans.de

# Im Testbetrieb werden interne Mail und Kundenbestätigung ausschließlich an
# diese Testadresse umgeleitet. Niemals mit einer realen Kundenadresse testen.
INQUIRY_MAIL_TEST_MODE=false
INQUIRY_TEST_TO_EMAIL=

# Formularschutz. Vercel überschreibt x-forwarded-for mit der Client-IP. Auf
# Netlify leer lassen: dort schützen die verteilten Edge-Regeln in netlify.toml;
# OpenNext stellt context.ip nicht direkt im Next.js Route Handler bereit. Bei
# einem eigenen Reverse Proxy nur einen dort bereinigten Einzel-IP-Header setzen.
FORM_CLIENT_IP_HEADER=
# Geheimes, stabiles Salt aus dem Plattform-Secret-Store; nicht committen.
FORM_RATE_LIMIT_HASH_SALT=
# Atomarer, mehrinstanzfähiger TTL-Store (Upstash Redis REST ist mit Vercel
# kompatibel). Standardvariablen UPSTASH_REDIS_REST_URL/-TOKEN werden ebenfalls
# erkannt. Der Schreib-Token bleibt ausschließlich serverseitig.
FORM_PROTECTION_REST_URL=
FORM_PROTECTION_REST_TOKEN=
# Zusätzliche erlaubte Origins, kommasepariert (z. B. freigegebene Vorschau).
FORM_ALLOWED_ORIGINS=

# Produktion lehnt Formularversand kontrolliert ab, solange kein verteilter
# Store konfiguriert ist. Der lokale Speicher ist ausschließlich für npm run dev.
